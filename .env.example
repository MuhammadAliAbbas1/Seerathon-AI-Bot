# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Load these by reading .env explicitly. Do NOT read process.env directly:
# a stale GEMINI_API_KEY from a different Google account exists in the
# ambient shell environment and will silently shadow this file. See §5.6.

# --- Primary provider: Google Gemini via AI Studio -------------------------
# Project 268175794480. Models: gemini-2.5-flash (answer),
# gemini-2.5-flash-lite (route). Both verified callable on that project.
GEMINI_API_KEY=

# --- Fallback provider: OpenRouter (INSURANCE ONLY, manual switch) ---------
# Model: google/gemma-4-26b-a4b-it:free. See §5.6 — no automatic failover.
OPENROUTER_API_KEY=

# --- Which provider the backend uses. Switching is config, not code. -------
# gemini | openrouter
LLM_PROVIDER=gemini

# --- Deploy label. Logged at boot and returned by /api/health, so we can
# --- tell which project a deployment is talking to before demoing.
DEPLOY_ENV=dev

# --- Demo cache. OFF unless this is exactly "on". Leave it unset. ----------
# It replays recorded MODEL RESPONSES for the landing-screen example chips so
# they survive a provider outage. It is off on purpose, and the reason is
# perception rather than correctness: a hit returns in well under a second,
# and sub-second reads as hardcoded to anyone who has used an AI product.
# The safety logic still runs on a hit — see api/src/demo-cache.ts and §5.6.
# Turn it on ONLY if quota exhaustion actually bites during judging.
# DEMO_CACHE=on
